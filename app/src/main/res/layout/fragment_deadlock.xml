<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deadlock Simulator"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Banker's Algorithm — safety-state simulation"
            android:textColor="@color/mk_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Scenario"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/deadlock_scenarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:id="@+id/deadlock_safe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Safe state" />
                    <RadioButton
                        android:id="@+id/deadlock_unsafe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unsafe state" />
                </RadioGroup>

                <Button
                    android:id="@+id/deadlock_run"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Run Safety Check" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Need Matrix (User Input)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Edit the values below. The Safe/Unsafe options autofill sample values."
                    android:textColor="@color/mk_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="        R1        R2        R3"
                    android:textColor="@color/mk_text_secondary"
                    android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="P1" android:textStyle="bold" />
                    <EditText android:id="@+id/need_p1_r1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p1_r2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p1_r3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="P2" android:textStyle="bold" />
                    <EditText android:id="@+id/need_p2_r1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p2_r2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p2_r3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="P3" android:textStyle="bold" />
                    <EditText android:id="@+id/need_p3_r1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p3_r2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p3_r3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="P4" android:textStyle="bold" />
                    <EditText android:id="@+id/need_p4_r1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p4_r2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p4_r3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:text="P5" android:textStyle="bold" />
                    <EditText android:id="@+id/need_p5_r1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p5_r2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                    <EditText android:id="@+id/need_p5_r3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:inputType="number" android:maxLength="3" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Available Resources"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <EditText android:id="@+id/available_r1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:hint="R1" android:inputType="number" />
                    <EditText android:id="@+id/available_r2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:hint="R2" android:inputType="number" />
                    <EditText android:id="@+id/available_r3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:hint="R3" android:inputType="number" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/deadlock_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deadlock_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/mk_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/deadlock_available"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deadlock_finish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textColor="@color/mk_text_secondary" />

                <TextView
                    android:id="@+id/deadlock_p1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@color/mk_badge_bg"
                    android:padding="10dp"
                    android:text="P1    READY"
                    android:textColor="@color/mk_badge_text"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/deadlock_p2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@color/mk_badge_bg"
                    android:padding="10dp"
                    android:text="P2    READY"
                    android:textColor="@color/mk_badge_text"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/deadlock_p3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@color/mk_badge_bg"
                    android:padding="10dp"
                    android:text="P3    READY"
                    android:textColor="@color/mk_badge_text"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/deadlock_p4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@color/mk_badge_bg"
                    android:padding="10dp"
                    android:text="P4    READY"
                    android:textColor="@color/mk_badge_text"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/deadlock_p5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@color/mk_badge_bg"
                    android:padding="10dp"
                    android:text="P5    READY"
                    android:textColor="@color/mk_badge_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deadlock_sequence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Safe sequence: —"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deadlock_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="NOT RUN"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/deadlock_next"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="Next Step" />
                    <Button
                        android:id="@+id/deadlock_auto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="Auto Play" />
                </LinearLayout>
                <Button
                    android:id="@+id/deadlock_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reset" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
